# Copied to .env by scripts/init.sh. Never commit .env.
# Note: docker --env-file does not strip trailing comments — keep comments on their own lines.

# Auth for the agent's OpenAI-compatible API (generated by init.sh).
API_SERVER_KEY=

# Slack gateway — app created from config/slack-manifest.json.
# Bot token, xoxb-... (Install App / OAuth & Permissions)
SLACK_BOT_TOKEN=
# App-level token, xapp-... (Basic Information → App-Level Tokens, scope connections:write)
SLACK_APP_TOKEN=
# Comma-separated Slack Member IDs allowed to talk to the agent, e.g. U01ABC2DEF3
SLACK_ALLOWED_USERS=
# Channel ID where scheduled (cron) results are posted, e.g. C0123456789
SLACK_HOME_CHANNEL=
# Legacy Hermes ambient-channel override; leave empty. Pilot stores each
# channel's Respond automatically setting in pilot-slack-controls instead.
SLACK_FREE_RESPONSE_CHANNELS=

# Dashboard login (generated by init.sh). Open http://127.0.0.1:9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Agent timezone. "auto" = owner's Slack profile, else this machine. Or an IANA name, e.g. Asia/Seoul.
# scripts/detect-timezone.sh (run by init.sh) writes TZ and HERMES_TIMEZONE below from this.
AGENT_TIMEZONE=auto
